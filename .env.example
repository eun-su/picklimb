# Firebase Console > Project settings > Your apps > Web app의 구성값을 복사하세요.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Vercel Environment Variables에도 같은 값을 설정하세요.
VITE_ACCESS_CODE=CHANGE_ME
# 운영진용 코드입니다. 일반 멤버에게 공유하지 마세요.
VITE_ADMIN_CODE=CHANGE_ME_ADMIN
