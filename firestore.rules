rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function memberRole() { return get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role; }
    function administrator() { return signedIn() && memberRole() == 'admin'; }
    function operator() { return signedIn() && (memberRole() == 'admin' || memberRole() == 'staff'); }
    function activeMember() { return signedIn() && (memberRole() == 'admin' || memberRole() == 'staff' || memberRole() == 'member' || memberRole() == 'paused'); }
    function ownsRecord() { return signedIn() && resource.data.memberId == request.auth.uid; }
    function validOwnCheckIn() {
      return request.resource.data.memberId == request.auth.uid
        && request.resource.data.memberName == get(/databases/$(database)/documents/members/$(request.auth.uid)).data.name
        && request.resource.data.date is string
        && request.resource.data.keys().hasOnly(['memberId', 'memberName', 'date', 'updatedAt']);
    }

    match /members/{memberId} {
      allow get: if signedIn() && (request.auth.uid == memberId || operator());
      allow list: if operator();
      allow write: if false;
    }

    match /attendance/{recordId} {
      allow read: if signedIn() && (memberRole() != 'withdrawn' || resource.data.memberId == request.auth.uid);
      allow create: if administrator() || (activeMember() && validOwnCheckIn());
      allow update: if administrator() || (activeMember() && ownsRecord() && validOwnCheckIn()
        && request.resource.data.memberId == resource.data.memberId
        && request.resource.data.memberName == resource.data.memberName
        && request.resource.data.date == resource.data.date);
      allow delete: if administrator() || (activeMember() && ownsRecord());
    }

    match /notices/{noticeId} {
      allow read: if signedIn();
      allow write: if administrator();
    }
  }
}
