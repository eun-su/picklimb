rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function administrator() { return signedIn() && role() == 'admin'; }
    function operator() { return signedIn() && (role() == 'admin' || role() == 'staff'); }
    function ownsRecord() { return signedIn() && resource.data.memberId == request.auth.uid; }
    function validCheckIn() {
      return request.resource.data.memberId == request.auth.uid
        && request.resource.data.memberName == get(/databases/$(database)/documents/members/$(request.auth.uid)).data.name
        && request.resource.data.date is string
        && request.resource.data.keys().hasOnly(['memberId', 'memberName', 'date', 'updatedAt']);
    }

    // Vercel 로그인 서버만 접근합니다.
    match /allowedMembers/{memberId} { allow read, write: if false; }
    match /loginAttempts/{attemptId} { allow read, write: if false; }

    match /members/{memberId} {
      allow get: if signedIn() && (request.auth.uid == memberId || operator());
      allow list: if operator();
      allow write: if false;
    }

    // 모든 멤버가 해당 날짜의 체크인 이름을 확인할 수 있지만, 본인 것만 바꿀 수 있습니다.
    match /attendance/{recordId} {
      allow read: if signedIn();
      allow create: if signedIn() && validCheckIn();
      allow update: if ownsRecord() && validCheckIn()
        && request.resource.data.memberId == resource.data.memberId
        && request.resource.data.memberName == resource.data.memberName
        && request.resource.data.date == resource.data.date);
      allow delete: if ownsRecord();
    }

    match /notices/{noticeId} {
      allow read: if signedIn();
      allow write: if administrator();
    }
  }
}
